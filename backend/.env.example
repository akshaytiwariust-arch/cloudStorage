# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Supported values for DB_CLIENT: mysql (recommended) or sqlite (auto-fallback if MySQL unconfigured)
DB_CLIENT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cloud_storage

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_cloud_storage_987654321
JWT_EXPIRES_IN=24h

# File Upload Limit (Bytes) - 10MB
MAX_FILE_SIZE=10485760

# Default Admin Seed Settings (Optional)
ADMIN_EMAIL=admin@cloud.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
